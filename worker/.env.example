# Copy this file to worker/.env for local Wrangler development.
# Never commit a real API key.
GEMINI_API_KEY="your_gemini_api_key"

# Optional paid-tier estimate inputs (USD per 1M tokens).
# Gemini 3.8 Flash introductory Standard pricing through 2026-12-31.
# Update to the current model/tier price before deploying after that date.
GEMINI_INPUT_USD_PER_MILLION_TOKENS="0.75"
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS="3.75"

# Optional controlled-environment access guard.
# If set, API requests must include Authorization: Bearer <token>.
# Keep this value in a Wrangler Secret for deployed Workers.
# PATHTUTOR_ACCESS_TOKEN="replace_with_a_long_random_token"

# Best-effort per-isolate request guard. Set to 0 only for controlled local use.
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"

# Comma-separated browser origins allowed to call the Worker.
ALLOWED_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Optional Wrangler deployment authentication.
# Prefer a scoped API token. Never commit real credentials.
# CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
# CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
